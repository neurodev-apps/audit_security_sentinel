<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <record id="ir_cron_verify_integrity" model="ir.cron">
        <field name="name">Security Sentinel: Verify Log Integrity</field>
        <field name="model_id" ref="model_audit_log"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model._cron_verify_integrity()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_send_anchor" model="ir.cron">
        <field name="name">Security Sentinel: Send Integrity Anchor</field>
        <field name="model_id" ref="model_audit_anchor"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_anchor()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">False</field>
    </record>

    <record id="ir_cron_cleanup_old_logs" model="ir.cron">
        <field name="name">Security Sentinel: Cleanup Old Audit Logs</field>
        <field name="model_id" ref="model_audit_log"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_old_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active">False</field>
    </record>

</data>
</odoo>
