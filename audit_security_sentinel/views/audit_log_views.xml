<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Audit Log Tree View -->
    <record id="view_audit_log_tree" model="ir.ui.view">
        <field name="name">audit.log.tree</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Logs" create="0" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="action_type" decoration-success="action_type == 'create'"
                       decoration-warning="action_type == 'write'"
                       decoration-danger="action_type == 'unlink'"/>
                <field name="model_model"/>
                <field name="name"/>
                <field name="res_id"/>
                <field name="ip_address"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Audit Log Form View -->
    <record id="view_audit_log_form" model="ir.ui.view">
        <field name="name">audit.log.form</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Action Information">
                            <field name="create_date" string="Date"/>
                            <field name="user_id"/>
                            <field name="action_type"/>
                            <field name="ip_address"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Resource Information">
                            <field name="model_model"/>
                            <field name="name"/>
                            <field name="res_id"/>
                            <field name="hash"/>
                            <field name="hash_version" groups="audit_security_sentinel.group_audit_manager"/>
                            <field name="previous_hash" groups="audit_security_sentinel.group_audit_manager"/>
                        </group>
                    </group>
                    <!-- CR-07: change details are restricted to Compliance Officers.
                         Audit Users only see metadata above. -->
                    <group string="Change Details" groups="audit_security_sentinel.group_audit_manager">
                        <field name="details" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Audit Log Search View -->
    <record id="view_audit_log_search" model="ir.ui.view">
        <field name="name">audit.log.search</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <search string="Search Audit Logs">
                <field name="user_id"/>
                <field name="model_model"/>
                <field name="name"/>
                <field name="res_id"/>
                <field name="ip_address"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter string="Creates" name="filter_create" domain="[('action_type', '=', 'create')]"/>
                <filter string="Updates" name="filter_write" domain="[('action_type', '=', 'write')]"/>
                <filter string="Deletes" name="filter_unlink" domain="[('action_type', '=', 'unlink')]"/>
                <separator/>
                <group name="group_by">
                    <filter string="User" name="groupby_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Model" name="groupby_model" context="{'group_by': 'model_model'}"/>
                    <filter string="Action Type" name="groupby_action" context="{'group_by': 'action_type'}"/>
                    <filter string="Date" name="groupby_date" context="{'group_by': 'create_date:day'}"/>
                    <filter string="Company" name="groupby_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Audit Log Action -->
    <record id="action_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_audit_log_search"/>
        <field name="context">{}</field>
        <field name="groups_id" eval="[(4, ref('audit_security_sentinel.group_audit_user'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No audit logs found
            </p>
            <p>
                Audit logs are automatically created when monitored actions are performed.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_audit_security_root"
              name="Security Sentinel"
              web_icon="audit_security_sentinel,static/description/icon.png"
              groups="audit_security_sentinel.group_audit_user"
              sequence="100"/>

    <menuitem id="menu_audit_logs"
              name="Audit Logs"
              parent="menu_audit_security_root"
              action="action_audit_log"
              sequence="10"/>

</odoo>
