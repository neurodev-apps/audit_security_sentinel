<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report Action -->
    <record id="action_report_audit" model="ir.actions.report">
        <field name="name">Security Audit Report</field>
        <field name="model">audit.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">audit_security_sentinel.report_audit</field>
        <field name="report_file">audit_security_sentinel.report_audit</field>
        <field name="print_report_name">'SecurityAuditReport_%s_%s' % (object.date_from, object.date_to)</field>
        <field name="groups_id" eval="[(4, ref('audit_security_sentinel.group_audit_user'))]"/>
    </record>

</odoo>
