<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Client Action -->
    <record id="action_audit_dashboard" model="ir.actions.client">
        <field name="name">Security Dashboard</field>
        <field name="tag">audit_security_sentinel.dashboard</field>
        <field name="target">main</field>
        <field name="groups_id" eval="[(4, ref('audit_security_sentinel.group_audit_user'))]"/>
    </record>

    <!-- Dashboard Menu Item (First in the list) -->
    <menuitem id="menu_audit_dashboard"
              name="Dashboard"
              parent="menu_audit_security_root"
              action="action_audit_dashboard"
              sequence="1"/>

</odoo>
