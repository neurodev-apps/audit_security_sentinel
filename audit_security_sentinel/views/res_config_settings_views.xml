<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_audit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.audit.sentinel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="audit_security_sentinel" string="Security Sentinel">
                    <block title="Audit Log Settings" name="audit_log_settings">
                        <setting
                            string="Log Retention"
                            help="Define how many days audit log records are kept before automatic purge.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="audit_retention_days" class="col-lg-4 o_light_label"/>
                                    <field name="audit_retention_days" class="col-lg-2"/>
                                </div>
                            </div>
                        </setting>
                        <setting
                            string="Dashboard Refresh"
                            help="How often (in seconds) the real-time dashboard auto-refreshes its data.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="audit_dashboard_refresh" class="col-lg-4 o_light_label"/>
                                    <field name="audit_dashboard_refresh" class="col-lg-2"/>
                                </div>
                            </div>
                        </setting>
                        <setting
                            string="Trusted Proxies"
                            help="Comma-separated proxy IPs allowed to set the client IP via X-Forwarded-For / X-Real-IP. Empty = record only the direct connection IP.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="audit_trusted_proxies" class="col-lg-4 o_light_label"/>
                                    <field name="audit_trusted_proxies" class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                        <setting
                            string="Sensitive Field Masking"
                            help="Extra comma-separated substrings that flag a field as sensitive. Matching values are stored as &lt;redacted&gt;. Adds to the built-in list (password, token, secret, api_key, iban, card, ...).">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="audit_sensitive_field_patterns" class="col-lg-4 o_light_label"/>
                                    <field name="audit_sensitive_field_patterns" class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Integrity &amp; Cryptography" name="audit_integrity_settings">
                        <setting
                            string="HMAC Key Verification"
                            help="Preview of the active HMAC key used for the HMAC-SHA256 integrity hashes. The full key is never displayed.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="audit_hash_salt_display" class="col-lg-4 o_light_label"/>
                                    <field name="audit_hash_salt_display" class="col-lg-4" readonly="1"/>
                                </div>
                                <div class="row mt-4">
                                    <div class="col-lg-8">
                                        <button
                                            name="action_regenerate_salt"
                                            type="object"
                                            string="Regenerate Salt"
                                            class="btn-secondary"
                                            icon="fa-refresh"
                                            groups="audit_security_sentinel.group_audit_manager"
                                            confirm="This will invalidate ALL existing integrity hashes. Proceed?"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
